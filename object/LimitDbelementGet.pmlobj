define object LimitDbelementGet
	member .view is dbref
endobject
--------------------------------------------------------------------------------------
define method .GetVolume() is volume
	--获取当前View的范围，基于插件生成的View会有六个面，直接拿上下两个切面的基点就可以得到范围了
	!view = !this.view
	!viewMembers = !view.members
	do !ptrViewMembers indices !viewMembers
		if(!viewMembers[$!ptrViewMembers].type eq 'VSEC' and !viewMembers[$!ptrViewMembers].name.matchwild('*UP'))then
			!limitsPositionTo = !viewMembers[$!ptrViewMembers].Plrf.pos.wrt(world)
		elseif(!viewMembers[$!ptrViewMembers].type eq 'VSEC' and !viewMembers[$!ptrViewMembers].name.matchwild('*DOWN'))then
			!limitsPositionFrom = !viewMembers[$!ptrViewMembers].Plrf.pos.wrt(world)
		endif
	enddo
	!volume = object volume(!limitsPositionFrom,!limitsPositionTo)
	return !volume
endmethod
--------------------------------------------------------------------------------------
--获取drawlist里在范围内的指定的类型的对象
define method .GetDrawListElement(!type is string) is array
	!view = !this.view
	!result = object array()
	!vol = !this.GetVolume()
	--【A·2026-11-10】逐条 ADDE 带 WITHIN 范围查：数据库展开时就按视图范围剪枝
	--   （命令 COLL ALL (类型) WITHIN from TO to FOR <条目>，见 limbo\functions\collect.pmlfnc）
	--   原来先把 ADDE 容器整个展开、再和范围内元素求交：范围小、容器大时白展开上万条。
	--   dbref 解析不出的条目退回 addscope 展开（只影响那几条）。
	!addeList = object array()
	!nRemeMembers = 0
	!nFallback = 0
	!fallbackColl = object collection()
	!fallbackColl.addtype(!type)
	!drawListMembers = !view.Idlname.members
	do !ptrDrawListMembers indices !drawListMembers
		!mType = !drawListMembers[$!ptrDrawListMembers].type
		!mName = !drawListMembers[$!ptrDrawListMembers].Idname
		if(!mType eq 'ADDE' or !mType eq 'REME')then
			!gotDr = false
			!srch = object DBREF()
			!srch = !mName
			!gotDr = true
			handle any
				!gotDr = false
			endhandle
			if(!mType eq 'REME')then
				!nRemeMembers = !nRemeMembers + 1
			endif
			if(!gotDr)then
				!cOne = object collect()
				!cOne.volume = !vol
				!cOne.types = !type
				!cOne.search = !srch
				!part = !!collect(!cOne)
				if(!mType eq 'ADDE')then
					do !pp indices !part
						!addeList.append(!part[$!pp])
					enddo
				else
					do !pq indices !part
						!jj = !addeList.FindFirst(!part[$!pq])
						if(!jj.unset().not())then
						!addeList.DeleteFrom(!jj,1)
						endif
					enddo
					!addeList.Compress()
				endif
			elseif(!mType eq 'ADDE')then
				!nFallback = !nFallback + 1
				!fallbackColl.addscope(!mName)
			endif
		endif
	enddo
	-- 解析不出 dbref 的 ADDE 条目：退回老办法展开（数量少，代价可控）
	if(!nFallback gt 0)then
		!fbList = !fallbackColl.results()
		do !pf indices !fbList
			!addeList.append(!fbList[$!pf])
		enddo
	endif
	!addeList.unique()
	-- 一条都没匹配到时，退回「视图范围内全部」（E3D 兼容，与原逻辑一致）
	if(!addeList.size() lt 1)then
		!collect = object collect()
		!collect.volume = !vol
		!collect.types = !type
		!volueDbelementList = !!collect(!collect)
		if(!volueDbelementList.size() gt 0)then
			if(!nRemeMembers gt 0)then
				$p DrawList/volume intersection empty - using view-volume elements (REME exclusions NOT applied):
				$p $!type
			endif
			do !pv indices !volueDbelementList
				!addeList.append(!volueDbelementList[$!pv])
			enddo
			!addeList.unique()
		endif
	endif
	!result = !addeList
	return !result
endmethod
--------------------------------------------------------------------------------------
--用来判断某点是否在某范围内
define method .IsPointWithinLimit(!point is position,!volume is volume) is boolean
	!px = !point.east
	!py = !point.north
	!pz = !point.up
	!cx = !volume.box().position.east
	!cy = !volume.box().position.north
	!cz = !volume.box().position.up
	!hx = !volume.box().XLENGTH / 2
	!hy = !volume.box().YLENGTH / 2
	!hz = !volume.box().ZLENGTH / 2
	!bool = abs(!px - !cx) le !hx and abs(!py - !cy) le !hy and abs(!pz - !cz) le !hz
	return !bool
endmethod
--------------------------------------------------------------------------------------
--用来判断某线段是否与当前范围相交
define method .IsLineIntersectLimit(!pointA is position,!pointB is position,!volume is volume) is boolean
	!boolA = !this.IsPointWithinLimit(!pointA,!volume)
	!boolB = !this.IsPointWithinLimit(!pointB,!volume)
	!bool = !boolA ne !boolB
	return !bool
endmethod
--------------------------------------------------------------------------------------
--【本次新增·按你的要求】"视图范围内的设备"——**全插件唯一口径**：
--   · 取 DrawList 里的 EQUI（GetDrawListElement('EQUI')）；
--   · 位置一律用 **.pos.wrt(world)** 再与视图范围比。
--   【为什么要有这个】23.99 之前四个地方各自实现，坐标口径还不一致：
--     尺寸标注 DimensionGenerator.GetEquipment() 用 .pos（**局部**坐标）、
--     设备名标注 LabelGenerator（EQUI 类别）用 .pos.wrt(world)、
--     中心线 NoteGenerator 用 .pos、设备表 GridDataGet.GetEquiRows 用 .pos。
--   设备若挂在非世界原点的层级下，两种口径结果不同 → 出现
--   "某台设备有名称标注、却没有尺寸标注"这种自相矛盾的现象。
--   现在统一走这里，四处不会再分叉。
define method .GetEquiInView() is array
	!list = !this.GetDrawListElement('EQUI')
	!volume = !this.GetVolume()
	!keep = object array()
	do !i indices !list
		!point = !list[$!i].pos.wrt(world)
		!inside = !this.IsPointWithinLimit(!point,!volume)
		if(!inside)then
			!keep.append(!list[$!i])
		endif
	enddo
	return !keep
endmethod
--------------------------------------------------------------------------------------
--【本次新增·按你的要求】"视图范围内的仪表"——仪表点位图（InstLayout）用。
--   口径：先按 DrawList 取（GetDrawListElement('INST')，与其它标注同一套）；
--   若 DrawList 里一台仪表都没有（很多项目的 AddList 只放了区域/管线，仪表挂在别处），
--   退化为"整个视图范围里的 INST"（object collect + volume），并打印一行提示。
--   为什么要有这个兜底：没有它时"图面无仪表标注 + 仪表表 0 行"会同时出现，
--   用户看到的就是"仪表点位图里没有仪表"。
define method .GetInstInView() is array
	!list = !this.GetDrawListElement('INST')
	if(!list.size() gt 0)then
		return !list
	endif
	!collect = object collect()
	!collect.volume = !this.GetVolume()
	!collect.types = 'INST'
	!list = !!collect(!collect)
	!list.unique()
	!nFallback = !list.size()
	$p Instrument fallback - DrawList has no INST, using all INST inside the view =
	$p $!nFallback
	return !list
endmethod
--------------------------------------------------------------------------------------
