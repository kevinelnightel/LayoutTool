define method .GenerateGridLabelLib(!drawingName is string,!size is string)
	NEW LALB /$!drawingName/GRIDLABELS
	FONT 1
	GBOX 1mm
	CHEI 4
	CSPA 0
	LSPA 0
	SIZE $!size
	TXCOLO 10
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1

	NEW SYTM /$!drawingName/GRIDLABELS/EAST
	XYPS X 80 Y 50mm
	JUST Left
	ALIGN Hbody
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	TXCOLO 10
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	MSTYLE Stop Scale 1
	MCOLOUR 1
	PPDI 0
	NEW MARKPRIMITIVE
	Origin Offset X 8 Y 0
	MSTYLE Stop Scale 1
	MCOLOUR 9
	END
	--【本次修改·按你的要求】这里原来有一条 STRAIGHT，但 Fpt 与 Tpt 是同一个点
	--   （零长度，PDMS 每次建图都报 Warning: ... Two points are superimposed）。
	--   零长度直线画出来什么都没有，所以直接不建它 —— 警告消失，图形不变。
	--   注：这不是错误而是 Warning，handle 抓不到；skip 也只能用在 do 循环里，故用『不创建』实现跳过。
	NEW CIRCLE
	Origin Centre Offset X 8 Y 0
	DIAM 16
	NLSTYL Solid
	NLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	END
	NEW TEXTPRIMITIVE
	Origin Offset X 8 Y 0
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	JUST Centre
	ALIGN Hbody
	BTEX '#ATEXT'
	TXCOLO 10
	
	NEW SYTM /$!drawingName/GRIDLABELS/WEST
	XYPS X 20mm Y 50mm
	JUST Left
	ALIGN Hbody
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	TXCOLO 10
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	MSTYLE Stop Scale 1
	MCOLOUR 1
	PPDI 0
	NEW MARKPRIMITIVE
	Origin Offset X -8 Y 0
	MSTYLE Stop Scale 1
	MCOLOUR 9
	END
	--【本次修改·按你的要求】这里原来有一条 STRAIGHT，但 Fpt 与 Tpt 是同一个点
	--   （零长度，PDMS 每次建图都报 Warning: ... Two points are superimposed）。
	--   零长度直线画出来什么都没有，所以直接不建它 —— 警告消失，图形不变。
	--   注：这不是错误而是 Warning，handle 抓不到；skip 也只能用在 do 循环里，故用『不创建』实现跳过。
	NEW CIRCLE
	Origin Centre Offset X -8 Y 0
	DIAM 15mm
	NLSTYL Solid
	NLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	END
	NEW TEXTPRIMITIVE
	Origin Offset X -8 Y 0
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	JUST Centre
	ALIGN Hbody
	BTEX '#ATEXT'
	TXCOLO 10
	
	NEW SYTM /$!drawingName/GRIDLABELS/NORTH
	XYPS X 50mm Y 80mm
	JUST Left
	ALIGN Hbody
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	TXCOLO 10
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	MSTYLE Stop Scale 1
	MCOLOUR 1
	PPDI 0
	NEW MARKPRIMITIVE
	Origin Offset X 0 Y 8
	MSTYLE Stop Scale 1
	MCOLOUR 9
	END
	--【本次修改·按你的要求】这里原来有一条 STRAIGHT，但 Fpt 与 Tpt 是同一个点
	--   （零长度，PDMS 每次建图都报 Warning: ... Two points are superimposed）。
	--   零长度直线画出来什么都没有，所以直接不建它 —— 警告消失，图形不变。
	--   注：这不是错误而是 Warning，handle 抓不到；skip 也只能用在 do 循环里，故用『不创建』实现跳过。
	NEW CIRCLE
	Origin Centre Offset X 0 Y 8
	DIAM 15mm
	NLSTYL Solid
	NLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	END
	NEW TEXTPRIMITIVE
	Origin Offset X 0 Y 8
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	JUST Centre
	ALIGN Hbody
	BTEX '#ATEXT'
	TXCOLO 10
	
	NEW SYTM /$!drawingName/GRIDLABELS/SOUTH
	XYPS X 50mm Y 20mm
	JUST Left
	ALIGN Hbody
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	TXCOLO 10
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	MSTYLE Stop Scale 1
	MCOLOUR 1
	PPDI 0
	NEW MARKPRIMITIVE
	Origin Offset X 0 Y -8
	MSTYLE Stop Scale 1
	MCOLOUR 9
	END
	--【本次修改·按你的要求】这里原来有一条 STRAIGHT，但 Fpt 与 Tpt 是同一个点
	--   （零长度，PDMS 每次建图都报 Warning: ... Two points are superimposed）。
	--   零长度直线画出来什么都没有，所以直接不建它 —— 警告消失，图形不变。
	--   注：这不是错误而是 Warning，handle 抓不到；skip 也只能用在 do 循环里，故用『不创建』实现跳过。
	NEW CIRCLE
	Origin Centre Offset X 0 Y -8
	DIAM 15mm
	NLSTYL Solid
	NLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	END
	NEW TEXTPRIMITIVE
	Origin Offset X 0 Y -8
	FONT 1
	CHEI 4
	CSPA 0
	LSPA 0
	JUST Centre
	ALIGN Hbody
	BTEX '#ATEXT'
	TXCOLO 10
endmethod
-------------------------------------------------------------------
--新建仪表标注自定义标注样式
define method .GenerateInstlabelLib(!drawingName is string,!size is string)
	--【本次新增·按你的要求】仪表点位图的图面标注用 6 号（靛蓝）；
	--   其它图种（管道布置图等）仍是老版的 10 号（白），行为不变。
	--   注：这条标注里"白色 10 号"的就是文字（LALB / SYTM / TEXTPRIMITIVE 三处 TXCOLO）；
	--   小圆圈(1 号)与定位点(9 号)本来不是白色，按你的说法这次不动。
	!cInstLbl = 10
	if(!this.layoutKind eq 'InstLayout')then
		!cInstLbl = 6
	endif
	NEW LALB /$!drawingName/INSTLABELS
	FONT 1
	GBOX 1mm
	CHEI 2.5mm
	CSPA 0
	LSPA 0
	SIZE $!size
	TXCOLO $!cInstLbl
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	--仪表的自定义样式
	NEW SYTM /$!drawingName/INSTLABELS/INST
	XYPS X 50mm Y 50mm
	JUST Left
	ALIGN Bbody
	FONT 1
	CHEI 2mm
	CSPA 0
	LSPA 0
	TXCOLO $!cInstLbl
	NLSTYL Solid
	NLCOLO 1
	LLSTYL Solid
	LLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	MSTYLE Stop Scale 1
	MCOLOUR 1
	PPDI 0
	NEW MARKPRIMITIVE
	Origin Offset X 0mm Y 0mm
	MSTYLE Stop Scale 1
	MCOLOUR 9
	END
	--【本次修改·按你的要求】这里原来有一条 STRAIGHT，但 Fpt 与 Tpt 是同一个点
	--   （零长度，PDMS 每次建图都报 Warning: ... Two points are superimposed）。
	--   零长度直线画出来什么都没有，所以直接不建它 —— 警告消失，图形不变。
	--   注：这不是错误而是 Warning，handle 抓不到；skip 也只能用在 do 循环里，故用『不创建』实现跳过。
	NEW CIRCLE
	Origin Centre Offset X 0mm Y 0mm
	DIAM 8mm
	NLSTYL Solid
	NLCOLO 1
	FSTYLE Off
	FCOLOUR 1
	END
	NEW TEXTPRIMITIVE
	Origin Offset X 0mm Y 0mm
	FONT 1
	--【2026-10-31·按你的要求】仪表气泡里的文字图元 CHEI 2.5 → 2mm
	CHEI 2mm
	CSPA 0
	LSPA 0
	JUST Centre
	ALIGN Hbody
	BTEX '#ATEXT'
	TXCOLO $!cInstLbl
endmethod
-------------------------------------------------------------------
