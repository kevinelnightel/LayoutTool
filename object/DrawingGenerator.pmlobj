	NLSTYL Solid
	NLCOLO 10
	LLSTYL Solid
	LLCOLO 10
	FSTYLE Off
	FCOLOUR 10
	NEW TEXTPRIMITIVE
	Origin Offset X 0mm Y 0mm
	FONT 1
