--添加drawlist
define method .MethodAddDrawListMember()
	!type = !!ce.type
	if(!type ne 'GPWL' and !type ne 'GPSET' and !type ne 'SITE' and !type ne 'ZONE' and !type ne 'PIPE' and !type ne 'EQUI' and !type ne 'STRU' and !type ne 'HVAC' and !type ne 'REST')then
		return
	endif
	!drawList	=	!this.listDrawList.dtext
	!drawList.append(name)
	!drawList.unique()
	!this.listDrawList.dtext	=	!drawList
endmethod
