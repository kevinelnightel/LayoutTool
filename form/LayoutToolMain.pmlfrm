define method .MethodLoadDrawlistFile()
	!filePath = !this.textDrawlistConfig.val
	!viewList = object array()
	!xmlGenerator = object XmlGenerator()
	!tempArray = !xmlGenerator.LoadXmlFile(!filePath)
	!this.listDrawList.clear()
	!this.listDrawList.dtext =  !tempArray[1]
	
	!this.listRemoveList.clear()
	!this.listRemoveList.dtext =  !tempArray[2]

	!this.memberViewList.clear()
	!this.memberViewList =  !tempArray[3]
	
	!this.listViewList.clear()
	do !i indices !this.memberViewList
		!viewListTemp[1]	=	!i.string()
		!viewListTemp[2]	=	!this.memberViewList[$!i].viewName
		!viewList.append(!viewListTemp)
