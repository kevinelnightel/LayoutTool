--获取当前切图的范围
define method .MethodCurrentScope()
	var !name flnn
	
	!volume = object volume(!!ce)
	handle any
		return
	endhandle
	!volumeFromPosition				=		!volume.from
	!volumeToPosition				=		!volume.to
	!this.textFromEast.val			=		!volumeFromPosition.east
	!this.textFromNorth.val			=		!volumeFromPosition.north
	!this.textFromUp.val			=		!volumeFromPosition.up
	!this.textToEast.val			=		!volumeToPosition.east
	!this.textToNorth.val			=		!volumeToPosition.north
	!this.textToUp.val				=		!volumeToPosition.up
	
	!this.textDrawingName.val			=		!name + '_Drwg'
	!this.MethodShowAidBox()
endmethod
--【本次修改·按你的要求】NewView 按钮与 .MethodNewView() 已删除（该按钮只做"按当前设置新建一个 VIEW"，
--   与 Generate 流程重复，平时用不上）。Generate / SaveView / UpdateView / CopyView 不受影响。

---------------------------------------------------------------------------
--生成
define method .MethodGenerateView()
	!regi								=	!this.textRegi.val
	----------------------------------------------------------------------------
	--【本次新增·按你的要求】建图之前先判断"同名 DRWG 是否已存在"：
	--   存在 → 弹确认框；选"是"就把它删掉再继续建新图，选"否"直接 return（什么都不做）。
	--   · 路径统一补成绝对路径（本工程 `textDrawingName` 不带前导 '/'，但为稳妥仍判断一次，
	--     避免又拼出 `//名字` —— 这个坑在 23.25 记过）；
	--   · 存在性判断用 `路径.dbref()` + handle 兜底（`.dbref()` 找不到会报错，与 23.5 的做法一致）；
	--   · 删除写法照抄 AVEVA 自己的删图函数 MdsAbaDelDrwg.pmlfnc：
	--       `!!CE = <DRWG>` → `delete DRWG`，若报 (2,18)（元素被锁）则 `unlock all` 后重试一次，再失败就报错返回；
	--     确认框也用那里同款 `!!alert.confirm(...).boolean()`（另一处常见写法是 `.eq('YES')`，两者都可用）；
	--   · 提示文字用英文：中文在 PDMS 弹窗里同样有编码显示问题（与 23.20 进度栏同一原因）。
	!checkName = !this.textDrawingName.val
	!checkPath = !checkName
	!hasSlashChk = false
	if(!checkPath.before('/') eq '')then
		!hasSlashChk = true
	endif
	if(!hasSlashChk.not())then
		!checkPath = '/' + !checkPath
	endif
	!oldDrwgExists = true
	!oldDrwg = !checkPath.dbref()
	handle any
		!oldDrwgExists = false
	endhandle
	if(!oldDrwgExists)then
		!question = 'Drawing ' + !checkName + ' already exists. Delete it and create a new one?'
		if(!!alert.confirm(!question).boolean().not())then
			return
		endif
		-- 删除：CE 指到那个 DRWG 再 delete DRWG
		!!ce = !oldDrwg
		!delOk = true
		delete DRWG
		handle any
			!delOk = false
		endhandle
		if(!delOk)then
			-- 常见原因是元素被锁住（(2,18)）：解锁后重试一次
			unlock all
			!delOk = true
			delete DRWG
			handle any
				!delOk = false
			endhandle
		endif
		if(!delOk)then
			!!alert.error('Failed to delete the existing drawing: ' + !checkPath)
			return
		endif
	endif
	----------------------------------------------------------------------------
	!drawingGenerator					=	object DrawingGenerator()
	!drawingGenerator.drawingName		=	!this.textDrawingName.val
	!drawingGenerator.drawingSize		=	!this.textDrawingSize.val
	!drawingGenerator.drawlist			=	!this.listDrawList.dtext
	!drawingGenerator.removelist		=	!this.listRemoveList.dtext
	--【本次新增·按你的要求】图纸种类（Layout 选项）传给建图对象：
	--   EquiLayout = 设备布置图：颜色规则里只有设备有颜色，其余灰 1 号。
	!layoutKind = !this.optionLayoutKind.selection()
	!drawingGenerator.layoutKind = !layoutKind
	--【2026-10-31·按你的要求】真正开始建图前清空两个 list，等出表时再按当前图纸种类重新填；
	--   放在这里而不是方法开头：万一“同名图纸已存在”你选了否，就不应该把现有列表清掉。
	!this.listPipeTable.clear()
	!this.listSuppTable.clear()
	$!regi
	!drawingGenerator.Generate()

	!viewList = !this.memberViewList
	!sel = !this.listViewList.val
	--【23.162 删除】原来这里有一句 !sheetList = !this.memberViewList，
	--   赋值后全方法再没被读过（死变量），删之；下面用的是 !viewList。
	!SheetGenerator						=	object SheetGenerator()
	
	!SheetGenerator.drawingName			=	!this.textDrawingName.val
	!SheetGenerator.sheetName			=	!this.textDrawingName.val + '/S'
	!SheetGenerator.sheetSize			=	!this.textDrawingSize.val
	
	!SheetGenerator.viewPositionFrom	=	!viewList[$!sel].viewLimitFrom
	!SheetGenerator.viewPositionTo		=	!viewList[$!sel].viewLimitTo
	!viewSize							=	object array()
	!viewSize[1]						=	!this.textViewSizeX.val.STRING()
	!viewSize[2]						=	!this.textViewSizeY.val.STRING()
	!SheetGenerator.viewSize			=	!viewSize
	!viewPosition						=	object array()
	!viewPosition[1]					=	!this.textViewPositionX.val.STRING()
	!viewPosition[2]					=	!this.textViewPositionY.val.STRING()
	!SheetGenerator.viewPosition		=	!viewPosition
	!SheetGenerator.viewDirection		=	!this.optionDirection.selection()
	!SheetGenerator.viewScale			=	!this.textScale.val.STRING()
	!SheetGenerator.viewType			=	!this.optionViewType.selection()
	
	!SheetGenerator.Generate('SHEE')
	
	---------------------------------------------------------------------------
	--【本次修改】把 Test 按钮的自动标注并入 Generate
	-- 问题：原来点 Generate 只建图（DRWG/SHEET/VIEW），标注必须再点一次 Test。
	-- 现在：建完图后紧接着跑同一套标注流程（与原来 Test 按钮跑的标注流程完全一致），
	--       只额外加了两处保护：
	--         ① 切不到视图时提示并返回（不让标注失败盖掉"图已建好"这件事）；
	--         ② 未设置 GRID（轴网）时跳过尺寸标注并提示 —— 老逻辑里
	--            `!gridstring.dbref()` 在轴网为空时会报错，把整段标注带断。
	-- Test 按钮保留：用于在同一张视图上单独重跑标注（不重新建图）。
	--【第2版修订】取视图改为**显式路径**，不依赖"当前视图"是谁
	-- 第1版这里写的是 `view` + `!view = !!ce`：DrawingGenerator/SheetGenerator 内部最后
	-- 停在 SHEET / 最后创建的图层上，`view` 取到的未必是刚建好的这张视图 —— 实测表现为
	-- "第一次点 Generate 标注不生效，要再点一次"。改为按 /<图名>/S/V 显式定位。
	!viewPath = '/' + !this.textDrawingName.val + '/S/V'
	!viewOk = true
	!view = !viewPath.dbref()
	-- 【PML 语义提醒】handle 覆盖的是它前面的语句（依据 AVEVA 自带代码
	-- chkruledata.pmlfrm:772-780 的用法），所以危险语句写在 handle 之前。
	handle any
		!viewOk = false
	endhandle
	if(!viewOk.not())then
		$p New view not found - automatic annotation skipped.
		$p Expected view path:
		$p $!viewPath
		return
	endif
	-- 把"当前元素"切到该视图：LabelGenerator 建图层用的是相对路径 <view.name>/xxx，
	-- 必须与 Test 按钮执行时的上下文一致
	$!viewPath
	!gridstring = !this.textGrid.val
	!gridOk = true
	if(!gridstring.unset())then
		!gridOk = false
	elseif(!gridstring.length() lt 1)then
		!gridOk = false
	else
		!grids = !gridstring.dbref()
		handle any
			!gridOk = false
		endhandle
	endif
	!labelGenerator = object LabelGenerator()
	!labelGenerator.view = !view
	--【本次新增·按你的要求】EquiLayout：只出设备名标注（不出管道/支架/仪表/管口标注）
	!labelGenerator.layoutKind = !layoutKind
	!noteGenerator = object NoteGenerator()
	!noteGenerator.view = !view
	--【本次新增·按你的要求】EquiLayout：设备注释改成图面直接标设备名
	!noteGenerator.layoutKind = !layoutKind
	--【本次新增·按你的要求】Drawing Setting 里的 Layout 选项决定这次生成什么：
	--   General                              = 只生成图面（标注、表格全部跳过）；
	--   PipeLayout / EquiLayout / InstLayout = 与原来完全一致（全套标注 + 自动出表）；
	--   NozzleLayout(Vertical)          = 只出**立式**设备的管口方位图；
	--   NozzleLayout(Horizontal)        = 只出**卧式**设备的管口方位图。
	--   后两种模式：管口名注记 + 方位角扇形线 + 管口方位表，**不**跑管线/支架/仪表标注，
	--   也不做尺寸与范围标记 —— 与老版两条独立入口（mnozzapply → mvnozzapply / mhnozzapply）
	--   的用法一致：管口方位图本来就是单独一张图。
	--   立式/卧式的判定读设备自身属性 EQUI.ORIE（见 NozzleOrientationGenerator.DetectOrientation）。
	!layoutKind = !this.optionLayoutKind.selection()
	!nozzOrie = ''
	if(!layoutKind eq 'NozzleLayout(Vertical)')then
		!nozzOrie = 'VERTICAL'
	elseif(!layoutKind eq 'NozzleLayout(Horizontal)')then
		!nozzOrie = 'HORIZONTAL'
	endif
	if(!nozzOrie ne '')then
		!this.MethodNozzleOrieFor(!view,!nozzOrie)
	elseif(!layoutKind ne 'General')then
	!labelGenerator.Generate()
	!noteGenerator.Generate()
	--【23.153 修改·按你的要求】没设 GRID 时**不再整段跳过尺寸 / 引线标注** ——
	--   只跳过**轴网那一层**：不设 .grid，DimensionGenerator.GetGrid() 会返回 4 个空数组，
	--   设备层 / 管道层照常生成；轴网中心线那边自己会 `!grid.unset()` 跳过。
	--   （原来这里走 else 分支、连 `!dimensionGenerator.Generate()` 都不调 —— 那是设计错误，
	--     表现为"GRID 一空，尺寸标注和引线标注全没了"。）
	!dimensionGenerator = object DimensionGenerator()
	!dimensionGenerator.view  = !view
	if(!gridOk)then
		!dimensionGenerator.grid  = !grids
	endif
	--【本次新增·按你的要求】EquiLayout：外围标注只两层（外=轴网、内=设备）
	!dimensionGenerator.layoutKind = !layoutKind
	--【本次新增·按你的要求】设备 EL / 管道 BOP EL 标注同样要减相对标高
	!dimensionGenerator.relative = !this.RelativeElevation()
	!dimensionGenerator.Generate()
	--【本次新增】范围标记 + 北向标：并入生成流程（按你的要求）
	--   原先要点界面上的 Limits 页按钮（该页已去掉），现在点 Generate 一次做完。
	--   失败不打断流程（缺符号库只打印警告，四角范围标记仍会画出来）。
	!this.MethodLimitsNoteFor(!view)
	--【本次新增】自动出表：支架表 + 管线表（数据取自刚建好的这张视图，与标注同源）
	!this.MethodAutoTables(!view)
	endif
	--【第2版修订】刷新图纸，让刚生成的标注与表格立即显示
	-- SheetGenerator.Generate 内部的刷屏发生在"建图结束"时，早于本段标注/表格，
	-- 所以必须在这里再刷新一次，否则要等下一次操作才看得见。
	!SheetGenerator.sheetupdate()
endmethod
---------------------------------------------------------------------------
--设置GRID位置
define method .MethodGrid()
	!name = !!ce.name
	!this.textGrid.val = !name
endmethod
---------------------------------------------------------------------------
--这个设置drawing获取存放位置
define method .MethodRegi()
	!type = !!ce.type
	if(!type eq 'REGI')then
		!name = !!ce.name
		!this.textRegi.val = !name
	else
		!!alert.Message('Please select REGI')
	endif
endmethod
---------------------------------------------------------------------------
--显示范围
define method .MethodShowAidBox()
	aid clear all
	!xlen = abs(!this.textToEast.val - !this.textFromEast.val)
	handle any
		return
	endhandle
	!ylen = abs(!this.textToNorth.val - !this.textFromNorth.val)
	!zlen = abs(!this.textToUp.val - !this.textFromUp.val)
	!xcenter = (!this.textToEast.val + !this.textFromEast.val) / 2
	!ycenter = (!this.textToNorth.val + !this.textFromNorth.val) / 2
	!zcenter = (!this.textToUp.val + !this.textFromUp.val) / 2
	aid box number 1 pos x $!xcenter y $!ycenter z $!zcenter wrt /* xlen $!xlen ylen $!ylen zlen $!zlen fill off
endmethod

---------------------------------------------------------------------------
