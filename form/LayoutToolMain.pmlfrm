define method .MethodOpenDrawlistFile()
	using namespace 'Aveva.Pdms.Presentation'
	!browser = object PMLFILEBROWSER('SAVE')
	var !userEvar '%PDMSUSER%'
	!browser.show(!userEvar, 'Drawlist.xml', 'Drawlist file', false, 'xml files (*.xml)|*.xml', 2)
	!outFileName = !browser.file()
	if (!outFileName eq '') then
  		!this.textDrawlistConfig.val = '%PDMSUSER%\Drawlist.xml'
	else
		!this.textDrawlistConfig.val = !outFileName
	endif
endmethod
