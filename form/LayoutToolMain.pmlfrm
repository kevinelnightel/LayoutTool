--设置drawing的尺寸
define method .MethodSetDrawingSize()
	!drawingSize						=					!this.optionDrawingSize.selection()
	!this.textDrawingSize.val			=					!drawingSize
	!this.textDrawingSize.Editable		=					false
	!this.textDrawingSize.SetEditable(false)
	!positionX							=					!drawingSize.before(' ').real()
	!positionY							=					!drawingSize.after(' ').real()
	!this.textViewPositionX.val			=					!positionX / 2
	!this.textViewPositionY.val			=					!positionY / 2
	--【本次修改·按你的要求】表格原点不再写进输入框（Tables 页已删）：
	--   现在由 TableOrigin() 按当前图幅现算 —— Y = 图幅高 − 70、支架表 X = 图幅宽 − 139、其余 X = 30。
endmethod
---------------------------------------------------------------------------
--计算View的比例
define method .MethodNearViewSize()
	!scaleListString		=		|1/2/5/10/15/20/25/30/40/50/75/80/100/150/200/300/350/400/450/500/550/600|
	!scaleListArray			=		!scaleListString.split('/')
	!drawingSizeX			=		!this.textDrawingSize.val.before(' ').real()
	!drawingSizeY			=		!this.textDrawingSize.val.after(' ').real()
	
	!direction				=		!this.optionDirection.selection()
	if(!direction eq 'D' or !direction eq 'U')then
		do !scale value !scaleListArray
			!xValue = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale.real()
			!yValue = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale.real()
			if(!xValue lt !drawingSizeX and !yValue lt !drawingSizeY)then
				!this.textViewSizeX.val = !xValue
				!this.textViewSizeY.val = !yValue
				!this.textScale.val = !scale.real()
				break
			endif
		enddo
	elseif(!direction eq 'N' or !direction eq 'S')then
		do !scale value !scaleListArray
			!xValue = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale.real()
			!yValue = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale.real()
			if(!xValue lt !drawingSizeX and !yValue lt !drawingSizeY)then
				!this.textViewSizeX.val = !xValue
				!this.textViewSizeY.val = !yValue
				!this.textScale.val = !scale.real()
				break
			endif
		enddo
	elseif(!direction eq 'E' or !direction eq 'W')then
		do !scale value !scaleListArray
			!xValue = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale.real()
			!yValue = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale.real()
			if(!xValue lt !drawingSizeX and !yValue lt !drawingSizeY)then
				!this.textViewSizeX.val = !xValue
				!this.textViewSizeY.val = !yValue
				!this.textScale.val = !scale.real()
				break
			endif
		enddo
	else
		do !scale value !scaleListArray
			!xLen = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale.real()
			!yLen = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale.real()
			!zLen = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale.real()
			!xValue = 0.866025 * (!xLen + !yLen)
			!yValue = 0.5 * (!xLen + !yLen) + !zLen
			
			if(!xValue lt !drawingSizeX and !yValue lt !drawingSizeY)then
				!this.textViewSizeX.val = !xValue
				!this.textViewSizeY.val = !yValue
				!this.textScale.val = !scale.real()
				break
			endif
		enddo
	endif
endmethod
---------------------------------------------------------------------------
--计算View的比例
define method .MethodReSize()
	!direction				=		!this.optionDirection.selection()
	!scale					=		!this.textScale.val
	if(!direction eq 'D' or !direction eq 'U')then
		!xValue = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale
		!yValue = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale
	elseif(!direction eq 'N' or !direction eq 'S')then
		!xValue = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale
		!yValue = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale
	elseif(!direction eq 'E' or !direction eq 'W')then
		!xValue = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale.real()
		!yValue = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale.real()
	else
		!xLen = abs(!this.textFromEast.val - !this.textToEast.val)	/	!scale.real()
		!yLen = abs(!this.textFromNorth.val - !this.textToNorth.val)	/	!scale.real()
		!zLen = abs(!this.textFromUp.val - !this.textToUp.val)	/	!scale.real()
		!xValue = 0.866025 * (!xLen + !yLen)
		!yValue = 0.5 * (!xLen + !yLen) + !zLen
	endif
	
	!this.textViewSizeX.val = !xValue
	!this.textViewSizeY.val = !yValue
	
endmethod
